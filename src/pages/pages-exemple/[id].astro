---
import Base from '../../layouts/Base.astro';
import '../../styles/pages-exemple.css';
import { documentHtml, pagesExemple, type PageExemple } from '../../lib/pagesExemple';
import { lienTesteur } from '../../lib/partage';
import { cssDePage } from '../../lib/stylesPagesExemple';
import { url } from '../../lib/url';

export function getStaticPaths() {
  return pagesExemple.map((page) => ({ params: { id: page.id }, props: { page } }));
}

const { page } = Astro.props as { page: PageExemple };
// Affichage seulement : ce document n'est jamais évalué, on peut donc y insérer une balise <style>.
const rendu = documentHtml(page).replace('</head>', `<style>${cssDePage(page.id)}</style></head>`);
---

<Base title={page.titre}>
  <h1>{page.titre}</h1>
  <p>{page.description}</p>
  <p><a class="bouton" href={lienTesteur(url('testeur/'), { langage: 'css', selecteur: '', page: page.id })}>Ouvrir dans le Testeur</a></p>
  <div class="page-exemple">
    <section>
      <h2>Rendu</h2>
      <iframe class="page-exemple__rendu" title={`Rendu : ${page.titre}`} sandbox="" srcdoc={rendu}></iframe>
    </section>
    <section>
      <h2>Code HTML</h2>
      <pre class="page-exemple__source"><code>{page.html}</code></pre>
    </section>
  </div>
</Base>
