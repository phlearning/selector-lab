---
import { getCollection } from 'astro:content';
import Jeu from '../components/jeu/Jeu';
import source from '../content/niveaux.yaml?raw';
import Base from '../layouts/Base.astro';
import '../styles/assistant.css';
import '../styles/jeu.css';
import { envelopper } from '../lib/document';
import { md, mdInline } from '../lib/markdown';
import { documentHtml, pageExemple } from '../lib/pagesExemple';

const chapitres = [
  { id: 'bibliotheque', titre: 'La bibliothèque' },
  { id: 'formulaire', titre: 'Scénario : inscription' },
  { id: 'tableau', titre: 'Scénario : administration' },
  { id: 'panier', titre: 'Scénario : panier' },
];

// Les collections ne gardent pas l'ordre du fichier, qui est l'ordre de jeu.
const ordre = [...source.matchAll(/^- id: (\S+)/gm)].map((m) => m[1]);
const niveaux = (await getCollection('niveaux'))
  .sort((a, b) => ordre.indexOf(a.id) - ordre.indexOf(b.id))
  .map(({ id, data }) => ({
    id,
    chapitre: data.chapitre,
    titre: data.titre,
    notion: data.notion,
    consigne: data.consigne,
    // Même document que celui des vérifications en CI.
    html: data.page ? documentHtml(pageExemple(data.page)) : envelopper(data.scene ?? '', 'Niveau'),
    page: data.page,
    solutions: data.solutions,
    recommande: data.recommande,
    indices: data.indices.map(mdInline),
    lecon: md(data.lecon),
    reference: data.reference,
  }));
---

<Base title="Jeu" description="Apprendre les sélecteurs CSS, XPath et les requêtes ARIA en jouant, Niveau par Niveau.">
  <h1>Jeu</h1>
  <p class="intro-testeur">
    Écris le sélecteur qui désigne exactement les éléments mis en évidence. La bibliothèque se joue en CSS ou en XPath ;
    les Scénarios e2e, sur de vraies interfaces, se jouent aussi avec des Requêtes ARIA.
  </p>
  <Jeu client:only="preact" niveaux={niveaux} chapitres={chapitres} base={import.meta.env.BASE_URL} />
  <noscript><p class="notice">Le Jeu a besoin de JavaScript.</p></noscript>
</Base>
