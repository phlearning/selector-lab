---
// Page technique utilisée par les tests : elle expose le moteur d'évaluation du site
// pour vérifier chaque Exemple dans Chromium, Firefox et WebKit.
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>Vérification</title>
  </head>
  <body>
    <p>Page technique utilisée par les tests automatisés.</p>
    <script>
      import { envelopper } from '../lib/document';
      import { documentHtml, pageExemple } from '../lib/pagesExemple';
      import { evaluer, serialiser, type Langage } from '../lib/resultat';
      import { stylerPageExemple } from '../lib/stylesPagesExemple';

      function htmlDe(page: string | null, html?: string): string {
        return page === null ? envelopper(html ?? '', 'Niveau') : documentHtml(pageExemple(page));
      }

      /** Document affiché dans une iframe : nécessaire aux Requêtes ARIA (rôles, visibilité, noms). */
      function documentAffiche(html: string, page: string | null): Promise<{ doc: Document; retirer: () => void }> {
        return new Promise((resolve) => {
          const iframe = document.createElement('iframe');
          iframe.addEventListener(
            'load',
            () => {
              if (page) stylerPageExemple(iframe.contentDocument!, page);
              resolve({ doc: iframe.contentDocument!, retirer: () => iframe.remove() });
            },
            { once: true },
          );
          iframe.srcdoc = html;
          document.body.append(iframe);
        });
      }

      Object.assign(window, {
        selectorLab: {
          // Chaque évaluation part d'un document neuf : certains Exemples DOM modifient le document.
          async verifier(page: string | null, langage: Langage, selecteur: string, html?: string) {
            const source = htmlDe(page, html);
            if (langage === 'aria') {
              const { doc, retirer } = await documentAffiche(source, page);
              try {
                return serialiser(evaluer(doc, langage, selecteur));
              } finally {
                retirer();
              }
            }
            const doc = new DOMParser().parseFromString(source, 'text/html');
            return serialiser(evaluer(doc, langage, selecteur));
          },
        },
      });
      document.body.dataset.pret = 'oui';
    </script>
  </body>
</html>
