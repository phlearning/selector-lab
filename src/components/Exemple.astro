---
import Resultat from './Resultat.astro';
import { mdInline } from '../lib/markdown';
import { pageExemple } from '../lib/pagesExemple';
import { nomLangage } from '../lib/reference';
import type { Attendu } from '../lib/resultat';
import { lienTesteur } from '../lib/partage';
import type { Langage } from '../lib/resultat';
import { url } from '../lib/url';

interface Props {
  selecteur: string;
  langage: string;
  page: string;
  note?: string;
  attendu?: Attendu;
}

const { selecteur, langage, page, note, attendu } = Astro.props;
const pageEx = pageExemple(page);
const essayer = lienTesteur(url('testeur/'), { langage: langage as Langage, selecteur, page });
---

<figure class="exemple">
  <div class="exemple__code">
    <span class="etiquette-langage">{nomLangage(langage)}</span>
    <code>{selecteur}</code>
    <a class="essayer" href={essayer} aria-label={`Essayer ${selecteur} dans le Testeur`}>Essayer</a>
  </div>
  <figcaption>
    Sur <a href={url(`pages-exemple/${page}/`)}>{pageEx.titre}</a>
    {note && <> - <span set:html={mdInline(note)} /></>}
  </figcaption>
  <Resultat attendu={attendu} />
</figure>
